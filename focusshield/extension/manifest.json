{
    "manifest_version": 3,
    "name": "FocusShield by MySession",
    "version": "0.3.0",
    "description": "Block distracting websites and sync with FocusShield Desktop during focus sessions.",
    "permissions": [
        "storage",
        "alarms",
        "tabs",
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "service_worker.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://mysession.club/*",
                "https://www.mysession.club/*",
                "http://localhost/*",
                "http://127.0.0.1/*"
            ],
            "js": ["content_bridge.js"],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_title": "FocusShield",
        "default_popup": "popup.html"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "blocked.html",
                "blocked.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
